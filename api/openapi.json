{
  "openapi": "3.1.1",
  "info": {
    "title": "SatisfactoryLedger.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/catalog/imports": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "summary": "Import the game's Docs file (en-US.json)",
        "description": "Adds new entries, updates existing ones and marks entries missing from the file as no longer in the game. Importing the same file again changes nothing.",
        "operationId": "ImportCatalog",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "file": {
                        "$ref": "#/components/schemas/IFormFile"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "gameVersion": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/resource-node-imports": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "summary": "Import the node table the map tool writes (resource-nodes.json, ADR-0015)",
        "description": "Adds new nodes, updates existing ones and marks nodes missing from the table as no longer in the game. The game version comes from the table.",
        "operationId": "ImportResourceNodes",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/imports/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "One import: game version, time and what it changed",
        "operationId": "GetCatalogImport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/catalog/items": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Items, optionally only one form: ?form=solid or ?form=fluid",
        "operationId": "GetItems",
        "parameters": [
          {
            "name": "form",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/recipes": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Recipes with their per-minute rates, optionally only those that produce an item (alternates included)",
        "operationId": "GetRecipes",
        "parameters": [
          {
            "name": "produces",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecipeResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/transport-tiers": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Belt, lift and pipe tiers with their capacity per minute",
        "operationId": "GetTransportTiers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransportTierResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/resource-nodes": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Resource nodes and resource well satellites from the map, optionally only one resource: ?resource=Desc_OreIron_C",
        "operationId": "GetResourceNodes",
        "parameters": [
          {
            "name": "resource",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResourceNodeResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/extractors": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Miners and extractors with what they extract per minute on a normal-purity node at 100% clock speed",
        "operationId": "GetExtractors",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExtractorResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/world/snapshots": {
      "post": {
        "tags": [
          "World"
        ],
        "summary": "Import a save file (.sav) as a new world snapshot",
        "description": "Every import is kept. Recipes the Catalog doesn't know are listed in unknownRecipes; buildables that aren't modelled yet, such as stations, in unsupported.",
        "operationId": "ImportSave",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "World"
        ],
        "summary": "All imported snapshots, newest first",
        "operationId": "GetSnapshots",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SnapshotSummaryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/world/snapshots/{id}": {
      "get": {
        "tags": [
          "World"
        ],
        "summary": "One snapshot: when it was saved and imported, what it contains, and what the import couldn't place",
        "operationId": "GetSnapshot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/world/snapshots/{id}/output-belts": {
      "get": {
        "tags": [
          "World"
        ],
        "summary": "Candidate output belts in a snapshot: where items leave a group of machines (BR-W12)",
        "operationId": "GetOutputBelts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OutputBeltSuggestion"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/world/factories": {
      "post": {
        "tags": [
          "World"
        ],
        "summary": "Define a factory in a world by its output belt and input items (BR-W2)",
        "description": "A factory belongs to a world (a session name) and is traced in every snapshot of it. The output belt must be a belt in the world's latest snapshot.",
        "operationId": "DefineFactory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefineFactoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "World"
        ],
        "summary": "The factories defined in a world: ?world=<session name>",
        "operationId": "GetFactories",
        "parameters": [
          {
            "name": "world",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FactoryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/world/factories/{id}": {
      "get": {
        "tags": [
          "World"
        ],
        "summary": "One factory definition",
        "operationId": "GetFactory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/world/snapshots/{id}/factories": {
      "get": {
        "tags": [
          "World"
        ],
        "summary": "Every factory of the snapshot's world, traced in this snapshot (BR-W3, BR-W11)",
        "operationId": "TraceFactories",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FactoryTrace"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/world/snapshots/{id}/analysis": {
      "get": {
        "tags": [
          "World"
        ],
        "summary": "The findings of a snapshot: machines below 100% and why, bottlenecks, unused supply, and sources of unknown rate",
        "description": "Computed on request from the steady state of the snapshot's world (BR-A1 to A13); a big world takes some seconds. Rates per minute, to 4 decimals. Every list starts with the worst. A finding in a part of the world that didn't settle is marked approximate.",
        "operationId": "AnalyseSnapshot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/world/snapshots/{id}/factories/{factoryId}/analysis": {
      "get": {
        "tags": [
          "World"
        ],
        "summary": "The findings of one factory in a snapshot: what it makes, its machines and belts, and the suppliers that feed it (BR-A14)",
        "description": "The whole world is simulated, because a factory depends on its supply; a big world takes some seconds. Not found when the snapshot or factory doesn't exist, the factory belongs to another world, or its output belt isn't in this snapshot (BR-W11).",
        "operationId": "AnalyseFactory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "factoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactoryAnalysisResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisResponse": {
        "required": [
          "settled",
          "summary",
          "approximateParts",
          "machines",
          "bottlenecks",
          "unusedSupply",
          "unknownSupply"
        ],
        "type": "object",
        "properties": {
          "settled": {
            "type": "boolean"
          },
          "summary": {
            "$ref": "#/components/schemas/AnalysisSummary"
          },
          "approximateParts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApproximatePart"
            }
          },
          "machines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MachineFinding"
            }
          },
          "bottlenecks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BottleneckFinding"
            }
          },
          "unusedSupply": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnusedSupplyFinding"
            }
          },
          "unknownSupply": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnknownSupplyFinding"
            }
          }
        }
      },
      "AnalysisSummary": {
        "required": [
          "machines",
          "running",
          "starved",
          "outputBlocked",
          "noRecipe"
        ],
        "type": "object",
        "properties": {
          "machines": {
            "type": "integer",
            "format": "int32"
          },
          "running": {
            "type": "integer",
            "format": "int32"
          },
          "starved": {
            "type": "integer",
            "format": "int32"
          },
          "outputBlocked": {
            "type": "integer",
            "format": "int32"
          },
          "noRecipe": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ApproximatePart": {
        "required": [
          "buildables",
          "sweeps",
          "example"
        ],
        "type": "object",
        "properties": {
          "buildables": {
            "type": "integer",
            "format": "int32"
          },
          "sweeps": {
            "type": "integer",
            "format": "int32"
          },
          "example": {
            "type": "string"
          }
        }
      },
      "BottleneckFinding": {
        "required": [
          "id",
          "className",
          "capacity",
          "flow",
          "offeredMore",
          "position",
          "approximate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "format": "double"
          },
          "flow": {
            "type": "number",
            "format": "double"
          },
          "offeredMore": {
            "type": "number",
            "format": "double"
          },
          "position": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PositionDocument"
              }
            ]
          },
          "approximate": {
            "type": "boolean"
          }
        }
      },
      "BuildableReference": {
        "required": [
          "id",
          "className"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "className": {
            "type": "string"
          }
        }
      },
      "CatalogImportSource": {
        "enum": [
          "docsFile",
          "resourceNodeTable"
        ]
      },
      "DefineFactoryRequest": {
        "required": [
          "world",
          "name",
          "outputBelt",
          "inputItems"
        ],
        "type": "object",
        "properties": {
          "world": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "outputBelt": {
            "type": [
              "null",
              "string"
            ]
          },
          "inputItems": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ExtractorResponse": {
        "required": [
          "id",
          "name",
          "form",
          "amountPerCycle",
          "cycleSeconds",
          "extractionRate",
          "inGame"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "form": {
            "$ref": "#/components/schemas/ItemForm"
          },
          "amountPerCycle": {
            "type": "number",
            "format": "double"
          },
          "cycleSeconds": {
            "type": "number",
            "format": "double"
          },
          "extractionRate": {
            "$ref": "#/components/schemas/RateResponse"
          },
          "inGame": {
            "type": "boolean"
          }
        }
      },
      "FactoryAnalysisResponse": {
        "required": [
          "factoryId",
          "name",
          "settled",
          "summary",
          "output",
          "machines",
          "bottlenecks",
          "unusedSupply",
          "unknownSupply"
        ],
        "type": "object",
        "properties": {
          "factoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "settled": {
            "type": "boolean"
          },
          "summary": {
            "$ref": "#/components/schemas/AnalysisSummary"
          },
          "output": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FactoryOutput"
            }
          },
          "machines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MachineFinding"
            }
          },
          "bottlenecks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BottleneckFinding"
            }
          },
          "unusedSupply": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnusedSupplyFinding"
            }
          },
          "unknownSupply": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnknownSupplyFinding"
            }
          }
        }
      },
      "FactoryOutput": {
        "required": [
          "item",
          "now",
          "atFullSpeed"
        ],
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "now": {
            "type": "number",
            "format": "double"
          },
          "atFullSpeed": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "FactoryResponse": {
        "required": [
          "id",
          "world",
          "name",
          "outputBelt",
          "inputItems"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
