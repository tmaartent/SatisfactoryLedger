{
  "name": "satisfactory-ledger-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "ng-openapi-gen --config ng-openapi-gen.json",
    "prestart": "npm run generate:api",
    "start": "ng serve",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:api",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pree2e": "npm run generate:api",
    "e2e": "playwright test",
    "e2e:record": "node e2e/record.mjs"
  },
  "private": true,
  "packageManager": "npm@11.3.0",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  }
}
