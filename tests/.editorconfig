# Settings for test code only. Inherits everything from the root .editorconfig.

[*.cs]
# Test names are sentences in domain language: Injection_draws_secondary_only_up_to_free_capacity
# Three tools check names, so all three are switched off for tests.

# Analyzer: no underscores in identifiers
dotnet_diagnostic.CA1707.severity = none

# Roslyn naming rules (methods_should_be_pascalcase in the root .editorconfig)
dotnet_diagnostic.IDE1006.severity = none

# Rider/ReSharper's own naming inspection
resharper_inconsistent_naming_highlighting = none
