<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The test worlds, and their stored analyses that World.Tests reads instead of running the solver (issue #47). -->
    <Content Include="..\SatisfactoryLedger.World.SaveFile.Tests\Fixtures\*.sav" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\SatisfactoryLedger.World.Tests\Fixtures\*.json" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\World\SatisfactoryLedger.World\SatisfactoryLedger.World.csproj" />
    <ProjectReference Include="..\..\src\Modules\World\SatisfactoryLedger.World.Simulation\SatisfactoryLedger.World.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The network builder, items and result queries of the sweep's tests (written once, in World.Domain.Tests). -->
    <Compile Include="..\SatisfactoryLedger.World.Domain.Tests\TestFlow.cs" Link="TestFlow.cs" />
    <Compile Include="..\SatisfactoryLedger.World.Domain.Tests\Items.cs" Link="Items.cs" />
    <Compile Include="..\SatisfactoryLedger.World.Domain.Tests\FlowResultQueries.cs" Link="FlowResultQueries.cs" />
    <!-- The test worlds as stored snapshots (written once, in World.Tests). -->
    <Compile Include="..\SatisfactoryLedger.World.Tests\TestWorldSnapshot.cs" Link="TestWorldSnapshot.cs" />
  </ItemGroup>

</Project>
